{
  "name": "@eshnav/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "npm run build -w @eshnav/shared && drizzle-kit generate",
    "db:seed": "tsx --conditions=development src/db/seed.ts"
  },
  "dependencies": {
    "@eshnav/shared": "*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
